// Internal dimensions derived from the requested notation size.

#let metrics(size) = (
  quarter-width: size * 2,
  eighth-width: size * 1.5,
  short-width: size,
  min-measure-gap: size * 0.8,
  bar-width: size * 0.3,
  bar-gap: size * 0.35,
  beam-gap: size * 0.16,
  beam-note-width: size * 0.7,
  beam-thickness: size * 0.04,
  dot-radius: size * 0.075,
  dot-gap: size * 0.12,
  row-gap: size * 0.9,
  group-gap: size * 1.2,
)
